<?xml version="1.0"?>
<ruleset name="Laravel 12 Code Quality Rules"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0
                     http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="
                     http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>PHPMD ruleset for Laravel 12 project</description>

    <!-- Exclude paths -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <exclude-pattern>*/public/*</exclude-pattern>
    <exclude-pattern>*/bootstrap/cache/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/migrations/*</exclude-pattern>
    <exclude-pattern>*/seeders/*</exclude-pattern>

    <!-- Include paths -->
    <include-pattern>app/**/*.php</include-pattern>
    <include-pattern>routes/**/*.php</include-pattern>
    <include-pattern>database/**/*.php</include-pattern>
    <include-pattern>config/**/*.php</include-pattern>
    <include-pattern>tests/**/*.php</include-pattern>

    <!-- Code Size Rules -->
    <rule ref="rulesets/codesize.xml">
        <exclude name="TooManyPublicMethods"/>
        <exclude name="ExcessiveParameterList"/>
        <exclude name="ExcessiveClassComplexity"/>
    </rule>

    <!-- Unused Code Rules -->
    <rule ref="rulesets/unusedcode.xml">
        <exclude name="UnusedFormalParameter"/>
        <exclude name="UnusedPrivateField"/>
    </rule>

    <!-- Naming Rules -->
    <rule ref="rulesets/naming.xml">
        <exclude name="ShortVariable"/>
        <exclude name="LongVariable"/>
    </rule>

    <!-- Design Rules -->
    <rule ref="rulesets/design.xml">
        <exclude name="TooManyMethods"/>
        <exclude name="CouplingBetweenObjects"/>
    </rule>

    <!-- Controversial Rules -->
    <rule ref="rulesets/controversial.xml">
        <exclude name="CamelCasePropertyName"/>
        <exclude name="CamelCaseVariableName"/>
    </rule>

    <!-- Clean Code Rules -->
    <rule ref="rulesets/cleancode.xml">
        <exclude name="BooleanArgumentFlag"/>
        <exclude name="StaticAccess"/>
    </rule>
</ruleset>

